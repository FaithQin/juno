# Copy to .env and fill in. Never commit .env.

# Canvas: Account → Settings → "+ New Access Token". Shown once.
CANVAS_URL=https://canvas.stanford.edu
CANVAS_TOKEN=

# Todoist: Settings → Integrations → Developer → API token
TODOIST_TOKEN=

TIMEZONE=America/Los_Angeles

# Sync behaviour (defaults shown; see DECISIONS.md)
COMPLETE_WHEN_SUBMITTED=true
INCLUDE_UNDATED=false
BATCH_MIN_SIZE=2

# --- Phase 2: juno over Telegram ---------------------------------------------

# OpenAI: platform.openai.com → API keys (add a few dollars of credit first)
OPENAI_API_KEY=

# Telegram: message @BotFather → /newbot → copy the token
TELEGRAM_BOT_TOKEN=
# Leave empty the first time. Start the bot, send it /start, it replies with your chat id. Then:
TELEGRAM_CHAT_IDS=

# Ed Discussion: optional. Leave empty and juno uses the token inside your saved Ed login
# (uv run assistant browser-login ed). Only fill this if your Ed settings page offers API tokens.
ED_API_TOKEN=

# Google Calendar needs no keys here: put the OAuth client file at data/google_credentials.json
# and run `uv run assistant gcal-auth` once (see README).
